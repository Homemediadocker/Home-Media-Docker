# ==============================================================================
# Environment Configuration for News Sources Example Deployment
# ==============================================================================

# PostgreSQL database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=news_sources

# Database connection details for the backend container
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}

# Port configuration (ports exposed on the host machine)
FRONTEND_PORT=8082
BACKEND_PORT=3000
NEWS_FRONTEND_CONTAINER_NAME=news-frontend